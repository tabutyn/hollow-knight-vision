{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed policy selection v3",
  "description": "Structural vocabulary. Vision must also constrain decisionId to the pending decision and selection to null or one complete action from its captured offer. Handles are unique within that decision and operand type.",
  "type": "object",
  "properties": {
    "decisionId": {
      "$ref": "#/$defs/id"
    },
    "selection": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/traverse"
        },
        {
          "$ref": "#/$defs/fight"
        },
        {
          "$ref": "#/$defs/focus"
        },
        {
          "$ref": "#/$defs/lifeblood"
        },
        {
          "$ref": "#/$defs/inspect"
        },
        {
          "$ref": "#/$defs/talk"
        },
        {
          "$ref": "#/$defs/menu"
        }
      ]
    }
  },
  "required": [
    "decisionId",
    "selection"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "integer",
      "minimum": 0
    },
    "traverse": {
      "type": "object",
      "properties": {
        "policy": {
          "const": "traverse"
        },
        "waypointId": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "policy",
        "waypointId"
      ],
      "additionalProperties": false
    },
    "fight": {
      "type": "object",
      "properties": {
        "policy": {
          "const": "fight"
        },
        "enemyId": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "policy",
        "enemyId"
      ],
      "additionalProperties": false
    },
    "focus": {
      "type": "object",
      "properties": {
        "policy": {
          "const": "recover"
        },
        "method": {
          "const": "focus"
        }
      },
      "required": [
        "policy",
        "method"
      ],
      "additionalProperties": false
    },
    "lifeblood": {
      "type": "object",
      "properties": {
        "policy": {
          "const": "recover"
        },
        "method": {
          "const": "lifeblood"
        },
        "sourceId": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "policy",
        "method",
        "sourceId"
      ],
      "additionalProperties": false
    },
    "inspect": {
      "type": "object",
      "properties": {
        "policy": {
          "const": "interact"
        },
        "verb": {
          "const": "inspect"
        },
        "targetId": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "policy",
        "verb",
        "targetId"
      ],
      "additionalProperties": false
    },
    "talk": {
      "type": "object",
      "properties": {
        "policy": {
          "const": "interact"
        },
        "verb": {
          "const": "talk"
        },
        "targetId": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "policy",
        "verb",
        "targetId"
      ],
      "additionalProperties": false
    },
    "menu": {
      "type": "object",
      "properties": {
        "policy": {
          "const": "menu"
        },
        "menuId": {
          "$ref": "#/$defs/id"
        },
        "entryId": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "policy",
        "menuId",
        "entryId"
      ],
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "decisionId": 4,
      "selection": {
        "policy": "traverse",
        "waypointId": 0
      }
    },
    {
      "decisionId": 4,
      "selection": null
    }
  ]
}
