{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Historical v2 reply for a two-candidate offer",
  "description": "Archived score-based two-candidate format. Current replies use policy and parameters.",
  "type": "object",
  "properties": {
    "scores": {
      "type": "object",
      "properties": {
        "c0": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "c1": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    }
  },
  "required": [ "scores" ],
  "additionalProperties": false,
  "examples": [
    {
      "scores": {
        "c0": 85,
        "c1": 30
      }
    },
    {
      "scores": {}
    }
  ]
}
