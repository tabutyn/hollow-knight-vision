<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>HollowKnightVisionInputReceiver</AssemblyName>
    <RootNamespace>HollowKnightVisionInputReceiver</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <HK_MANAGED_DIR Condition="'$(HK_MANAGED_DIR)' == ''">/path/to/Hollow Knight.app/Contents/Resources/Data/Managed</HK_MANAGED_DIR>
    <HK_LOADER_DIR Condition="'$(HK_LOADER_DIR)' == ''">$(HK_MANAGED_DIR)</HK_LOADER_DIR>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Assembly-CSharp"><HintPath>$(HK_LOADER_DIR)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TeamCherry.TK2D"><HintPath>$(HK_MANAGED_DIR)/TeamCherry.TK2D.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(HK_MANAGED_DIR)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(HK_MANAGED_DIR)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(HK_MANAGED_DIR)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(HK_MANAGED_DIR)/UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.Physics2DModule"><HintPath>$(HK_MANAGED_DIR)/UnityEngine.Physics2DModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(HK_MANAGED_DIR)/UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(HK_MANAGED_DIR)/UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(HK_MANAGED_DIR)/Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PlayMaker"><HintPath>$(HK_MANAGED_DIR)/PlayMaker.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
