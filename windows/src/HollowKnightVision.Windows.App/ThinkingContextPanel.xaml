<UserControl x:Class="HollowKnightVision.Windows.App.ThinkingContextPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Focusable="False">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Background" Value="#121416"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="6"/>
        </Style>
    </UserControl.Resources>
    <Border Background="#F0151719" BorderBrush="#A87038" BorderThickness="1" CornerRadius="6" Padding="6">
        <Grid>
            <Button x:Name="Compact" Click="TogglePanel" HorizontalContentAlignment="Stretch" Padding="2"
                    Background="Transparent" BorderThickness="0" AutomationProperties.Name="Expand Thinking context">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="⌃" Foreground="Orange" Margin="4,0"/>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
                        <TextBlock x:Name="CompactLog" TextWrapping="Wrap" FontSize="11" FontFamily="Consolas" Foreground="Orange"/>
                    </ScrollViewer>
                </DockPanel>
            </Button>
            <DockPanel x:Name="Expanded" Visibility="Collapsed">
                <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" LastChildFill="True">
                    <WrapPanel DockPanel.Dock="Left" x:Name="Options">
                        <ComboBox x:Name="ModelCombo" MinWidth="124" DisplayMemberPath="Title" SelectionChanged="OptionsChanged"/>
                        <CheckBox x:Name="AutomaticCheck" Content="Automatic policies" Margin="8,0" VerticalAlignment="Center" Checked="OptionsChanged" Unchecked="OptionsChanged"/>
                        <CheckBox x:Name="CompatibilityCheck" Content="Separate Llama service" Margin="2,0,8,0" VerticalAlignment="Center" Checked="OptionsChanged" Unchecked="OptionsChanged"/>
                    </WrapPanel>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid>
                    <TabControl x:Name="Tabs" Background="#17191B" BorderBrush="#353739">
                        <TabItem Header="Context">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="22*"/><ColumnDefinition Width="24*"/><ColumnDefinition Width="23*"/><ColumnDefinition Width="31*"/></Grid.ColumnDefinitions>
                                <GroupBox Header="Text log" Foreground="White">
                                    <DockPanel><TextBlock x:Name="LogProfile" DockPanel.Dock="Top"/><TextBox x:Name="FullLog" Foreground="Orange"/></DockPanel>
                                </GroupBox>
                                <GroupBox Grid.Column="1" Header="Game information" Foreground="White"><TextBox x:Name="LiveEvidence"/></GroupBox>
                                <GroupBox Grid.Column="2" Header="Reasoning" Foreground="White"><TextBox x:Name="Reasoning"/></GroupBox>
                                <GroupBox Grid.Column="3" Header="Schema explorer" Foreground="White">
                                    <DockPanel><DockPanel DockPanel.Dock="Top">
                                        <Button DockPanel.Dock="Right" x:Name="CopyRequest" Content="Copy" Margin="4,0,0,0"
                                                Click="CopySelectedRequest" AutomationProperties.Name="Copy selected request"/>
                                        <ComboBox x:Name="Messages" SelectionChanged="SelectMessage"/>
                                    </DockPanel>
                                        <TextBox x:Name="MessageDetails" AutomationProperties.Name="Request messages and expected JSON schema"/>
                                    </DockPanel>
                                </GroupBox>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Screenshot"><DockPanel>
                            <TextBlock x:Name="FrameCaption" DockPanel.Dock="Top"/>
                            <Image x:Name="Screenshot" Stretch="Uniform" AutomationProperties.Name="Latest captured game frame"/>
                        </DockPanel></TabItem>
                        <TabItem Header="JSON"><DockPanel>
                            <TextBlock x:Name="HandoffText" DockPanel.Dock="Top" TextWrapping="Wrap"/>
                            <Button x:Name="DecisionFile" DockPanel.Dock="Top" HorizontalAlignment="Left" Visibility="Collapsed"
                                    Content="Show decision JSON in Explorer" Click="RevealDecision"/>
                            <Expander x:Name="AttachmentPanel" DockPanel.Dock="Top" Header="Screenshot for this reply" Foreground="White" Visibility="Collapsed">
                                <Image x:Name="Attachment" Height="105" Stretch="Uniform"/>
                            </Expander>
                            <TextBox x:Name="ReplyText" AutomationProperties.Name="Model JSON reply"/>
                        </DockPanel></TabItem>
                    </TabControl>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Content="⌄" Click="TogglePanel" AutomationProperties.Name="Collapse Thinking context"/>
                </Grid>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
