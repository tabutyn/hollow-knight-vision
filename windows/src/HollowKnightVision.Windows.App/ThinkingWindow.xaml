<Window x:Class="HollowKnightVision.Windows.App.ThinkingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thinking" Width="1060" Height="650" MinWidth="760" MinHeight="490"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,5">
            <CheckBox x:Name="EnabledCheck" Content="Enable Thinking" Foreground="#E6EDF3"
                      Margin="5,0,14,0" VerticalAlignment="Center" Checked="OptionsChanged" Unchecked="OptionsChanged"/>
            <ComboBox x:Name="ModelCombo" MinWidth="175" DisplayMemberPath="Title"
                      SelectionChanged="OptionsChanged" AutomationProperties.Name="Thinking model"/>
            <CheckBox x:Name="AutomaticCheck" Content="Automatic policies" Foreground="#E6EDF3"
                      Margin="14,0" VerticalAlignment="Center" Checked="OptionsChanged" Unchecked="OptionsChanged"/>
            <CheckBox x:Name="CompatibilityCheck" Content="Separate Llama service" Foreground="#E6EDF3"
                      Margin="4,0,12,0" VerticalAlignment="Center" Checked="OptionsChanged" Unchecked="OptionsChanged"/>
            <Button x:Name="OpenLog" Content="Game Text Log" Click="OpenLogClicked"/>
        </WrapPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="5,0,5,7" Foreground="#AABAD0"/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="52*"/><ColumnDefinition Width="48*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="50*"/><RowDefinition Height="50*"/></Grid.RowDefinitions>
            <GroupBox Grid.Row="0" Header="Latest screenshot" Foreground="#E6EDF3">
                <Border Background="Black"><Image x:Name="Screenshot" Stretch="Uniform" AutomationProperties.Name="Captured game frame"/></Border>
            </GroupBox>
            <GroupBox Grid.Row="1" Header="Model input" Foreground="#E6EDF3">
                <DockPanel>
                    <Expander x:Name="AttachmentPanel" DockPanel.Dock="Top" Foreground="#E6EDF3" Header="Model screenshot"
                              Margin="4,0,0,4" Visibility="Collapsed">
                        <Image x:Name="Attachment" Height="112" Stretch="Uniform"/>
                    </Expander>
                    <TextBox x:Name="InputText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Background="#171A20" Foreground="#E6EDF3" FontFamily="Consolas"/>
                </DockPanel>
            </GroupBox>
            <GroupBox Grid.Column="1" Grid.RowSpan="2" Header="Latest decision" Foreground="#E6EDF3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="50*"/><RowDefinition Height="50*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="HandoffText" TextWrapping="Wrap" Foreground="#AABAD0" Margin="4,0,4,5"/>
                    <DataGrid x:Name="Candidates" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False"
                              AutomationProperties.Name="Offered policies and model scores">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="42"/>
                            <DataGridTextColumn Header="Policy" Binding="{Binding Policy}" Width="100"/>
                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="*"/>
                            <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="58"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBox x:Name="ReplyText" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Background="#171A20" Foreground="#E6EDF3" FontFamily="Consolas" AutomationProperties.Name="Model JSON reply"/>
                </Grid>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
