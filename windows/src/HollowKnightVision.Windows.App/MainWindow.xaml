<Window x:Class="HollowKnightVision.Windows.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:HollowKnightVision.Windows.App"
        Title="" Height="760" Width="1100" MinHeight="560" MinWidth="720" WindowStartupLocation="Manual"
        WindowStyle="None" ResizeMode="CanResize" Background="#03070A" Foreground="#ECECEC" FontFamily="Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#202124" />
        <SolidColorBrush x:Key="PanelHover" Color="#303236" />
        <SolidColorBrush x:Key="Outline" Color="#35FFFFFF" />
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#ECECEC"/></Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#ECECEC"/><Setter Property="Background" Value="#26272A"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,4"/><Setter Property="Margin" Value="3,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Border" CornerRadius="0" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="#3A3B3F"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Border" Property="Background" Value="#18191B"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#ECECEC"/><Setter Property="Background" Value="#17181A"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/><Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#202020"/><Setter Property="Background" Value="#F3F3F3"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/><Setter Property="Padding" Value="5,3"/>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#ECECEC"/></Style>
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#D8D8D8"/><Setter Property="Background" Value="#202124"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="SegmentBorder" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SegmentBorder" Property="Background" Value="#3A3C40"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="SegmentBorder" Property="Background" Value="#245B86"/><Setter TargetName="SegmentBorder" Property="BorderBrush" Value="#75BEF5"/><Setter Property="Foreground" Value="White"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SegmentBorder" Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Toolbar" TargetType="Border">
            <Setter Property="Background" Value="#E8202124"/><Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/><Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#ECECEC"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="CaptionBorder" Background="{TemplateBinding Background}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CaptionBorder" Property="Background" Value="#2D3034"/></Trigger>
                    <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="Tag" Value="Close"/></MultiTrigger.Conditions><Setter TargetName="CaptionBorder" Property="Background" Value="#E81123"/></MultiTrigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="CaptionBorder" Property="Opacity" Value="0.72"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="0,32,0,0">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Black" CornerRadius="0" BorderThickness="0" ClipToBounds="True">
            <Grid>
                <!-- Gameplay: Mac canvas, live/atlas image, diagnostics only as overlays. -->
                <Grid x:Name="GameplayPanel" Background="Transparent" ClipToBounds="True" SizeChanged="GameplayPanel_SizeChanged"
                      MouseMove="GameViewport_MouseMove" MouseLeave="GameViewport_MouseLeave"
                      MouseLeftButtonDown="GameViewport_MouseLeftButtonDown"
                      MouseLeftButtonUp="GameViewport_MouseLeftButtonUp"
                      MouseWheel="AtlasViewport_MouseWheel">
                    <Canvas x:Name="GameplayAtlasCanvas" Width="640" Height="360" Background="Black"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            RenderTransformOrigin="0,0">
                        <Image x:Name="GameplayImage" Width="640" Height="360" Stretch="Fill"
                               SnapsToDevicePixels="True" IsHitTestVisible="False" Panel.ZIndex="10"/>
                        <Canvas x:Name="DetectionCanvas" Width="640" Height="360"
                                IsHitTestVisible="False" Panel.ZIndex="20"/>
                        <Canvas x:Name="GameplayGroundCanvas" Width="640" Height="360"
                                IsHitTestVisible="False" Panel.ZIndex="19"/>
                    </Canvas>
                    <StackPanel x:Name="GameplayPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⌖" FontSize="34" Foreground="#CC00FFFF" HorizontalAlignment="Center"/>
                        <TextBlock Text="Starting live atlas…" FontSize="13" Foreground="#999999" Margin="0,7,0,0"/>
                    </StackPanel>
                    <Border x:Name="VisionStatusOverlay" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10" Padding="10,6"
                            CornerRadius="0" Background="#A0000000">
                        <TextBlock x:Name="VisionStatusText" Text="Gameplay" FontSize="30" FontWeight="SemiBold"
                                   FontFamily="Consolas" Foreground="#F19A38"/>
                    </Border>
                    <Border x:Name="ObjectInferenceIssueOverlay" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Right"
                            Margin="8" Padding="7,4" Background="#A0000000" IsHitTestVisible="False" MaxWidth="360">
                        <TextBlock x:Name="ObjectInferenceIssueOverlayText" Foreground="#FF6868" FontFamily="Consolas" FontSize="11"
                                   TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>

                <!-- Label: Mac control order in one compact row, with Windows controls. -->
                <Grid x:Name="LabelPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Toolbar}" MinHeight="46"><Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="145"/>
                            <ColumnDefinition Width="2*" MinWidth="100" MaxWidth="280"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="2*" MinWidth="240" MaxWidth="340"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ContextCombo" Grid.Column="0" Height="30" VerticalContentAlignment="Center"
                                  AutomationProperties.Name="Context" SelectionChanged="ContextCombo_SelectionChanged"/>
                        <ComboBox x:Name="ClassCombo" Grid.Column="1" Margin="4,0,0,0" Height="30" IsEditable="False"
                                  VerticalContentAlignment="Center" AutomationProperties.Name="Object"
                                  SelectionChanged="ClassCombo_SelectionChanged">
                            <ComboBox.ItemTemplate><DataTemplate>
                                <TextBlock Text="{Binding Name}" Foreground="#202020" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock x:Name="LabelObjectsComplete" Grid.Column="1" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="16" Foreground="#62C27B" VerticalAlignment="Center" Margin="8,0"
                                   Visibility="Collapsed" ToolTip="All objects labeled" AutomationProperties.Name="All objects labeled"/>
                        <Button x:Name="NewObjectButton" Grid.Column="2" Content="+ Object" Margin="4,0,0,0" Click="NewObject_Click"/>
                        <UniformGrid x:Name="LabelModeSegments" Grid.Column="3" Margin="8,0,0,0" Columns="4" Height="30">
                            <RadioButton x:Name="LabelAddButton" GroupName="LabelMode" Content="Add" Style="{StaticResource Segment}" IsChecked="True" Checked="LabelMode_Checked" Click="LabelMode_Click"/>
                            <RadioButton x:Name="LabelModifyButton" GroupName="LabelMode" Content="Modify" Style="{StaticResource Segment}" Checked="LabelMode_Checked" Click="LabelMode_Click"/>
                            <RadioButton x:Name="LabelDeleteButton" GroupName="LabelMode" Content="Delete" Style="{StaticResource Segment}" Checked="LabelMode_Checked" Click="LabelMode_Click"/>
                            <RadioButton x:Name="LabelNegativeButton" GroupName="LabelMode" Content="Negative" Style="{StaticResource Segment}" Checked="LabelMode_Checked" Click="LabelMode_Click"/>
                        </UniformGrid>
                        <Button Grid.Column="5" Content="Recent Frames" Height="30" Margin="8,0,0,0" Click="RecentFrames_Click"/>
                    </Grid></Border>
                    <Border Grid.Row="1" Background="#55FFFFFF"/>
                    <Grid x:Name="LabelViewport" Grid.Row="2" Background="Black" ClipToBounds="True"
                          PreviewMouseWheel="LabelViewport_MouseWheel"
                          PreviewMouseDown="LabelViewport_MouseDown" PreviewMouseUp="LabelViewport_MouseUp"
                          MouseMove="LabelViewport_MouseMove" MouseLeave="LabelViewport_MouseLeave"
                          LostMouseCapture="LabelViewport_LostMouseCapture" SizeChanged="LabelViewport_SizeChanged">
                        <Viewbox x:Name="LabelViewbox" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                            <Viewbox.RenderTransform><TransformGroup>
                                <ScaleTransform x:Name="LabelZoomTransform"/>
                                <TranslateTransform x:Name="LabelPanTransform"/>
                            </TransformGroup></Viewbox.RenderTransform>
                            <Grid Width="640" Height="360">
                                <Image x:Name="LabelImage" Width="640" Height="360" Stretch="Fill"/>
                                <Canvas x:Name="LabelCanvas" Width="640" Height="360" Background="Transparent"
                                        MouseLeftButtonDown="LabelCanvas_MouseLeftButtonDown"
                                        MouseMove="LabelCanvas_MouseMove"
                                        MouseLeftButtonUp="LabelCanvas_MouseLeftButtonUp"/>
                            </Grid>
                        </Viewbox>
                        <!-- Screen-space guides stay thin at every image zoom. -->
                        <Canvas x:Name="LabelCrosshair" IsHitTestVisible="False" Visibility="Collapsed" Opacity="0.72">
                            <Line x:Name="LabelCrosshairHorizontal" Stroke="White" StrokeThickness="1" StrokeDashArray="2,3"/>
                            <Line x:Name="LabelCrosshairVertical" Stroke="White" StrokeThickness="1" StrokeDashArray="2,3"/>
                        </Canvas>
                    </Grid>
                </Grid>

                <Grid x:Name="StencilsPanel" Visibility="Collapsed" Background="#101419">
                    <Grid.Resources>
                        <Style x:Key="StencilContextItem" TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="#E7EBF0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="10,9"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="3">
                                    <Grid>
                                        <Border x:Name="Accent" Width="3" Background="#59ACF5" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,6"/>
                                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#252D37"/></Trigger>
                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#193D5A"/><Setter TargetName="Accent" Property="Visibility" Value="Visible"/></Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#8AC7FF"/><Setter TargetName="Row" Property="BorderThickness" Value="1"/></Trigger>
                                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Background" Value="Transparent"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></Setter.Value></Setter>
                        </Style>
                        <!-- Scoped dark scroll bar; other Windows controls are unchanged. -->
                        <Style TargetType="ScrollBar">
                            <Setter Property="Width" Value="10"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                            <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                        </RepeatButton></Track.DecreaseRepeatButton>
                                        <Track.Thumb><Thumb MinHeight="24">
                                            <Thumb.Template><ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Thumb" Background="#596574" CornerRadius="3" Margin="2,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Thumb" Property="Background" Value="#8796A8"/></Trigger>
                                                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="Thumb" Property="Background" Value="#B0C2D6"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate></Thumb.Template>
                                        </Thumb></Track.Thumb>
                                        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                            <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                        </RepeatButton></Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate></Setter.Value></Setter>
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid Background="#181E25">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel Margin="16,14,16,10">
                            <TextBlock x:Name="StencilProgressText" DockPanel.Dock="Right" Foreground="#9CAABB" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StencilSidebarTitle" Text="Stencil" FontSize="14" FontWeight="SemiBold"/>
                        </DockPanel>
                        <ListBox x:Name="StencilContextList" Grid.Row="1" Margin="8,0,6,8" Background="Transparent" Foreground="#E7EBF0"
                                 BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource StencilContextItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionChanged="StencilContextList_SelectionChanged" AutomationProperties.Name="Stencil contexts"/>
                        <Border Grid.Row="2" BorderBrush="#343C47" BorderThickness="0,1,0,0" Padding="12">
                            <Button x:Name="StencilResetButton" HorizontalAlignment="Left" Margin="0" Foreground="#F39A9A" Click="ResetStencils_Click"/>
                        </Border>
                    </Grid>
                    <Border Grid.Column="1" Background="#343C47"/>
                    <Grid Grid.Column="2" Margin="16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock x:Name="StencilContextTitle" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" TextTrimming="CharacterEllipsis"/>
                        <Border Grid.Row="1" Background="#090D11" BorderBrush="#343C47" BorderThickness="1" CornerRadius="3">
                            <Grid x:Name="StencilPreviewViewport" ClipToBounds="True" SizeChanged="StencilPreview_SizeChanged">
                                <Image x:Name="StencilPreviewImage" Stretch="Uniform"/>
                                <Canvas x:Name="StencilPreviewOverlay" IsHitTestVisible="False"/>
                                <StackPanel x:Name="StencilPreviewEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                                    <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="#718297" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                                    <TextBlock x:Name="StencilEmptyTitle" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="StencilEmptyGuidance" Foreground="#A9B8C8" Margin="0,8,0,0" MaxWidth="420" TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DockPanel x:Name="StencilPreviewActions" Grid.Row="2" LastChildFill="False" Margin="0,12,0,0">
                            <Button x:Name="StencilDeleteButton" DockPanel.Dock="Right" Margin="8,0,0,0" Foreground="#F39A9A" Click="StencilDelete_Click"/>
                            <Button x:Name="StencilEditButton" DockPanel.Dock="Left" Margin="0" Background="#165A8B" BorderBrush="#4A9DD8" Padding="14,7" Click="StencilEdit_Click"/>
                        </DockPanel>
                    </Grid>
                </Grid>

                <!-- Model: same toolbar and initial Summary arrangement as the Mac workspace. -->
                <Grid x:Name="ModelPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Toolbar}" MinHeight="46"><Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <local:TrainingControlsPanel x:Name="TrainingControls" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" ActionRequested="MacTrain_Click"/>
                        <UniformGrid Grid.Column="1" Width="300" Columns="3" VerticalAlignment="Center">
                            <RadioButton x:Name="ModelSummaryButton" GroupName="ModelTab" Content="Summary" Style="{StaticResource Segment}" IsChecked="True" Checked="ModelTab_Checked"/>
                            <RadioButton x:Name="ModelObjectsButton" GroupName="ModelTab" Content="Objects" Style="{StaticResource Segment}" Checked="ModelTab_Checked"/>
                            <RadioButton x:Name="ModelScreenshotsButton" GroupName="ModelTab" Content="Screenshots" Style="{StaticResource Segment}" Checked="ModelTab_Checked"/>
                        </UniformGrid>
                    </Grid></Border>
                    <Border Grid.Row="1" Background="#55FFFFFF"/>
                    <Grid Grid.Row="2">
                        <Grid x:Name="ModelSummaryPanel" Margin="14"/>
                        <Grid x:Name="ModelObjectsPanel" Visibility="Collapsed" Margin="14"/>
                        <Grid x:Name="ModelScreenshotsPanel" Visibility="Collapsed" Margin="14">
                            <TextBlock Text="Select a screenshot." Foreground="#999999" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Hacker: atlas occupies the full canvas. Ground toolbar is conditional. -->
                <Grid x:Name="HackerPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border x:Name="HackerGroundToolbar" Grid.Row="0" Style="{StaticResource Toolbar}" Visibility="Collapsed">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <UniformGrid Width="290" Columns="4">
                                    <RadioButton x:Name="GroundAddButton" Content="Add" GroupName="GroundMode" Style="{StaticResource Segment}" IsChecked="True" Click="GroundMode_Click"/>
                                    <RadioButton x:Name="GroundModifyButton" Content="Modify" GroupName="GroundMode" Style="{StaticResource Segment}" Click="GroundMode_Click"/>
                                    <RadioButton x:Name="GroundDeleteButton" Content="Delete" GroupName="GroundMode" Style="{StaticResource Segment}" Click="GroundMode_Click"/>
                                    <RadioButton x:Name="GroundNegativeButton" Content="Negative" GroupName="GroundMode" Style="{StaticResource Segment}" Click="GroundMode_Click"/>
                                </UniformGrid>
                                <Button x:Name="GroundUndoButton" Content="Undo" IsEnabled="False" Margin="8,0,3,0" Click="GroundUndo_Click"/>
                                <TextBlock x:Name="GroundCountText" Text="+0  −0" FontFamily="Consolas" Foreground="#999999" VerticalAlignment="Center" Margin="8,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Grid x:Name="HackerViewportPanel" Grid.Row="1" Background="Black"
                          MouseMove="GameViewport_MouseMove" MouseLeave="GameViewport_MouseLeave"
                          MouseLeftButtonDown="GameViewport_MouseLeftButtonDown"
                          MouseLeftButtonUp="GameViewport_MouseLeftButtonUp"
                          MouseWheel="AtlasViewport_MouseWheel">
                        <Canvas x:Name="AtlasCanvas" Width="640" Height="360" Background="Black"
                                HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0,0">
                            <Image x:Name="HackerLiveImage" Visibility="Collapsed" Stretch="Fill"
                                   SnapsToDevicePixels="True" IsHitTestVisible="False" Panel.ZIndex="10"/>
                            <Canvas x:Name="HackerOverlayCanvas" Width="640" Height="360" Background="Transparent" Panel.ZIndex="20"/>
                        </Canvas>
                        <StackPanel x:Name="AtlasEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="🔨" FontSize="34" Foreground="#80FF80"/></StackPanel>
                        <TextBlock x:Name="AtlasPreviewText" Visibility="Collapsed"/>
                    </Grid>
                </Grid>


            </Grid>
        </Border>

        <!-- One bottom row; diagnostic and atlas settings live behind the gear. -->
        <Grid Grid.Row="1" MinHeight="32" Background="#03070A">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <RadioButton x:Name="GameplayWorkspaceButton" GroupName="Workspace" Content="Gameplay" Style="{StaticResource Segment}" IsChecked="True" Checked="GameplayWorkspace_Click"/>
                <RadioButton x:Name="LabelWorkspaceButton" GroupName="Workspace" Content="Label" Style="{StaticResource Segment}" Checked="LabelWorkspace_Click"/>
                <RadioButton x:Name="StencilsWorkspaceButton" GroupName="Workspace" Content="Stencil" Style="{StaticResource Segment}" Checked="StencilsWorkspace_Click"/>
                <RadioButton x:Name="ModelWorkspaceButton" GroupName="Workspace" Content="Model" Style="{StaticResource Segment}" Checked="ModelWorkspace_Click"/>
                <RadioButton x:Name="HackerWorkspaceButton" GroupName="Workspace" Content="Hacker" Style="{StaticResource Segment}" Checked="HackerWorkspace_Click"/>
                <RadioButton x:Name="OpsWorkspaceButton" Visibility="Collapsed" GroupName="Workspace" Content="Ops" Style="{StaticResource Segment}" Checked="OpsWorkspace_Click"/>
            </StackPanel>
            <TextBlock x:Name="StencilGuidanceText" Grid.Column="1" Foreground="#5AA7FF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="PathRecordingButton" Content="K" Click="PathRecording_Click"/>
                <StackPanel x:Name="GameplayControlsPanel" Orientation="Horizontal">
                    <RadioButton Content="Free Fly" Tag="Free Fly" GroupName="GameplayFraming" Style="{StaticResource Segment}" Checked="CameraMode_Checked" Click="GameplayFraming_Click"/>
                    <RadioButton Content="Fit" Tag="Fit" GroupName="GameplayFraming" Style="{StaticResource Segment}" Checked="CameraMode_Checked" Click="GameplayFraming_Click"/>
                    <RadioButton Content="Current" Tag="Current" GroupName="GameplayFraming" Style="{StaticResource Segment}" Checked="CameraMode_Checked" Click="GameplayFraming_Click"/>
                </StackPanel>
                <StackPanel x:Name="HackerCameraControlsPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <RadioButton Content="Free Fly" Tag="Free Fly" GroupName="HackerFraming" Style="{StaticResource Segment}" Checked="CameraMode_Checked" Click="HackerMode_Click"/>
                    <RadioButton Content="Fit" Tag="Fit" GroupName="HackerFraming" Style="{StaticResource Segment}" Checked="CameraMode_Checked" Click="HackerMode_Click"/>
                    <RadioButton Content="Current" Tag="Current" GroupName="HackerFraming" Style="{StaticResource Segment}" Checked="CameraMode_Checked" Click="HackerMode_Click"/>
                </StackPanel>
            </StackPanel>
            <Button x:Name="SettingsButton" Grid.Column="3" Content="⚙" FontSize="18" ToolTip="Settings" AutomationProperties.Name="Settings" Click="Settings_Click"/>
        </Grid>

        <Grid x:Name="SettingsOverlay" MouseLeftButtonDown="SettingsBackdrop_Click" Grid.RowSpan="2" Background="#99000000" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Width="620" MaxHeight="760" Margin="24" Background="#202124" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="20">
                        <Button DockPanel.Dock="Right" Content="Done" Click="AtlasManagerDone_Click"/>
                        <TextBlock x:Name="SettingsTitle" Text="Settings" FontSize="20" FontWeight="SemiBold"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,0,20,20">
                            <StackPanel x:Name="GameplayAtlasManager">
                    <DockPanel><TextBlock Text="Manage Atlas" FontSize="18" FontWeight="SemiBold"/></DockPanel>
                    <TextBlock Text="Select Auto Save and Delete to clear the active atlas and start fresh. A recoverable backup is kept; stencil labels are not changed. Save State creates a named restore point." FontSize="12" Foreground="#999999" TextWrapping="Wrap" Margin="0,12"/>
                    <DockPanel><Button DockPanel.Dock="Right" Content="Save State" Click="AtlasSaveState_Click"/><TextBox x:Name="AtlasStateNameText"/></DockPanel>
                    <ListBox x:Name="AtlasStatesList" Height="180" Margin="0,12" SelectionChanged="AtlasStatesList_SelectionChanged"/>
                    <DockPanel><Button Content="New" Click="AtlasNew_Click"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="AtlasDeleteStateButton" Content="Delete" Click="AtlasDeleteState_Click" IsEnabled="False"/><Button x:Name="AtlasLoadStateButton" Content="Load" Click="AtlasLoadState_Click" IsEnabled="False"/></StackPanel></DockPanel>
                </StackPanel>
                            <StackPanel x:Name="HackerAtlasManager" Visibility="Collapsed" Margin="0,20,0,0">
                                <TextBlock Text="Manage Hacker Atlas" FontWeight="SemiBold"/>
                                <Button Content="Delete Atlas" HorizontalAlignment="Left" Foreground="#FF6868" Click="HackerDeleteAtlas_Click"/>
                            </StackPanel>
                            <WrapPanel x:Name="HackerControlsPanel" Visibility="Collapsed" Margin="0,12">
                                <RadioButton Content="Ground" Tag="Ground" GroupName="HackerSettingsMode" Style="{StaticResource Segment}" Checked="CameraMode_Checked" Click="HackerMode_Click"/><RadioButton Content="Rooms" Tag="Rooms" GroupName="HackerSettingsMode" Style="{StaticResource Segment}" Checked="CameraMode_Checked" Click="HackerMode_Click"/>
                                <RadioButton Content="Fit" Tag="Fit" GroupName="HackerSettingsMode" Style="{StaticResource Segment}" Checked="CameraMode_Checked" Click="HackerMode_Click"/><RadioButton Content="Free Fly" Tag="Free Fly" GroupName="HackerSettingsMode" Style="{StaticResource Segment}" Checked="CameraMode_Checked" Click="HackerMode_Click"/><RadioButton Content="Current" Tag="Current" GroupName="HackerSettingsMode" Style="{StaticResource Segment}" Checked="CameraMode_Checked" Click="HackerMode_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="OpsSettingsTitle" Text="Ops" FontWeight="SemiBold" Visibility="Collapsed"/>
                <!-- Ops: exact Mac PlayerOpsView copy. -->
                <Grid x:Name="OpsPanel" Visibility="Collapsed">
                    <Grid HorizontalAlignment="Stretch" Margin="0,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="Max Health" Margin="0,7"/><TextBox x:Name="OpsMaxHealthText" Grid.Column="1" Text="5" Width="72" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="1" Text="Health" Margin="0,7"/><TextBox x:Name="OpsHealthText" Grid.Row="1" Grid.Column="1" Text="5" Width="72" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="2" Text="Lifeblood Seed" Margin="0,7"/><TextBox x:Name="OpsLifebloodText" Grid.Row="2" Grid.Column="1" Text="0" Width="72" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="3" Text="Extra Mana Slots" Margin="0,7"/><TextBox x:Name="OpsManaSlotsText" Grid.Row="3" Grid.Column="1" Text="0" Width="72" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="4" Text="Mana" Margin="0,7"/><TextBox x:Name="OpsManaText" Grid.Row="4" Grid.Column="1" Text="99" Width="72" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="5" Text="Geo" Margin="0,7"/><TextBox x:Name="OpsGeoText" Grid.Row="5" Grid.Column="1" Text="18" Width="72" HorizontalAlignment="Right"/>
                        </Grid>
                        <CheckBox x:Name="OpsInvincibleCheck" Grid.Row="1" Content="Invincibility — ignore damage and phase through enemies" Margin="0,0,0,18"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,18"><Button Content="Randomize Now" Click="OpsRandomize_Click"/><Button Content="Restore Enemies" Click="OpsRestoreEnemies_Click"/></StackPanel>
                        <StackPanel Grid.Row="3"><Separator Margin="0,0,0,18"/><CheckBox x:Name="OpsRandomizeAfterLabelCheck" Content="Randomize health, lifeblood, mana, and geo after each Label session"/></StackPanel>
                        <StackPanel Grid.Row="5" Orientation="Horizontal"><Button Content="Apply" Click="OpsApply_Click"/><Button Content="Reload" Click="OpsReload_Click"/><TextBlock x:Name="OpsStatusText" Foreground="#999999" VerticalAlignment="Center" Margin="8,0"/></StackPanel>
                    </Grid>
                </Grid>
                            <Separator Margin="0,20"/>
                            <TextBlock x:Name="DebugSettings" Text="Debug View" FontWeight="SemiBold" Margin="0,0,0,12"/>

                            <CheckBox x:Name="GameStateCheck" Content="Game State" Margin="0,0,0,10" Checked="GameStateCheck_Changed" Unchecked="GameStateCheck_Changed"/>
                    <CheckBox x:Name="ObjectDetectionCheck" Content="Object Detection" Margin="0,0,0,10" Checked="ObjectDetectionCheck_Changed" Unchecked="ObjectDetectionCheck_Changed"/>
                    <TextBlock x:Name="ModelLockedText" TextWrapping="Wrap" Foreground="#999999" Margin="0,0,0,10"/>
                    <StackPanel x:Name="ObjectDetectionOptions" IsEnabled="False">
                        <TextBlock x:Name="ObjectInferenceIssueText" Foreground="#FF9F68" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8"/>
                        <CheckBox x:Name="RawDetectionCheck" Content="Raw Detection" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="Detection Extend"/><Slider x:Name="DetectionExtendSlider" Grid.Column="1" Minimum="0" Maximum="50" Value="12" Margin="8,0" ValueChanged="DetectionExtendSlider_ValueChanged"/><TextBlock x:Name="DetectionExtendText" Grid.Column="2" Text="12%" FontFamily="Consolas" HorizontalAlignment="Right"/></Grid>
                        <CheckBox x:Name="DetectionPixelsCheck" Content="Detection Pixels" Margin="0,0,0,10" Checked="DetectionPixelsCheck_Changed" Unchecked="DetectionPixelsCheck_Changed"/>
                    </StackPanel>
                    <CheckBox x:Name="StencilDetectionCheck" Content="Stencil Detection" Margin="0,0,0,10"/>
                    <TextBlock x:Name="StencilLockedText" TextWrapping="Wrap" Foreground="#999999" Margin="0,0,0,10"/>
                    <Separator Margin="0,0,0,10"/>
                    <CheckBox x:Name="GroundFeaturesCheck" Content="Ground Features" Margin="0,0,0,10"/>
                    <CheckBox x:Name="TransitionsCheck" Content="Transitions" Margin="0,0,0,10"/>
                    <CheckBox x:Name="CoarseMotionCheck" Content="Coarse Motion Overlay"/>


                            <Separator Margin="0,20"/>
                            <TextBlock x:Name="SettingsLanguageTitle" Text="Game language" Margin="0,0,0,5"/>
                            <ComboBox x:Name="SettingsLanguageCombo" SelectionChanged="SettingsLanguage_Changed" Margin="0,0,0,12"/>
                            <Separator Margin="0,12"/>
                            <Button x:Name="SettingsFactoryButton" Content="Factory Reset…" Foreground="#FF6868" HorizontalAlignment="Left" Click="FactoryReset_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Windows caption bar: draggable surface with standard controls at top right. -->
        <Border Grid.RowSpan="2" Panel.ZIndex="190" Height="32" VerticalAlignment="Top" Margin="0,-32,0,0"
                Background="#03070A" MouseLeftButtonDown="WindowTitleBar_MouseLeftButtonDown"/>
        <StackPanel Grid.RowSpan="2" Panel.ZIndex="200" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-32,0,0">
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize" Click="WindowMinimize_Click"/>
            <Button x:Name="WindowZoomButton" Style="{StaticResource CaptionButton}" Content="&#xE923;" ToolTip="Restore Down" Click="WindowZoom_Click"/>
            <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Tag="Close" ToolTip="Close" Click="WindowClose_Click"/>
        </StackPanel>

        <Grid x:Name="GameLostOverlay" Grid.RowSpan="2" Panel.ZIndex="300"
              Margin="0,-32,0,0" Background="#03070A" Visibility="Collapsed">
            <TextBlock x:Name="GameLostCountdownText"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="32" TextAlignment="Center" TextWrapping="Wrap"
                       FontSize="28" FontWeight="SemiBold" Foreground="#ECECEC"
                       AutomationProperties.LiveSetting="Assertive"/>
        </Grid>

        <!-- Existing implementation controls kept off-screen. Mac exposes none of this machinery. -->
        <Grid Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="StatusText"/><Button x:Name="StartGameplayButton" Click="StartGameplay_Click"/>
            <TextBox x:Name="VisionRunText"/><Button x:Name="StartVisionButton" Click="StartVision_Click"/><Button x:Name="StopVisionButton" Click="StopVision_Click"/>
            <TextBox x:Name="ExamplesRootText"/><ListBox x:Name="ExamplesList" SelectionChanged="ExamplesList_SelectionChanged"/><TextBox x:Name="ClassIdentifierText"/><CheckBox x:Name="HardNegativeCheck"/><TextBox x:Name="KnownClassesText"/><ListBox x:Name="BoxesList"/>
            <TextBox x:Name="ModelExamplesRootText"/><TextBox x:Name="DatasetRootText"/><TextBox x:Name="ModelIdentifierText"/><TextBox x:Name="ExportClassesText"/><TextBox x:Name="LatestDatasetText"/><TextBox x:Name="TrainingOutputText"/><TextBox x:Name="IterationsText" Text="100"/><TextBox x:Name="BaseCheckpointText"/><TextBox x:Name="TrainingLogText"/>
            <TextBox x:Name="OpsText"/><TextBox x:Name="AtlasOutputText"/><TextBox x:Name="AtlasSecondsText" Text="30"/><TextBox x:Name="AtlasPpuText" Text="64"/><Button x:Name="RecordAtlasButton" Click="RecordAtlas_Click"/>
            <TextBox x:Name="VisualRouteText"/><Button x:Name="RecordRouteButton" Click="RecordRoute_Click"/><Button x:Name="ReplayRouteButton" Click="ReplayRoute_Click"/><Button x:Name="BuildWorldButton" Click="BuildWorld_Click"/><Button x:Name="OptimizeWorldButton" Click="OptimizeWorld_Click"/><TextBlock x:Name="RouteStatusText"/>
            <TextBox x:Name="InputPathText"/><TextBox x:Name="InputPathRepeatsText" Text="1"/><CheckBox x:Name="RestorePathCheckpointCheck" IsChecked="True"/><Button x:Name="ReplayInputPathButton" Click="ReplayInputPath_Click"/>
        </Grid>
    </Grid>
</Window>
